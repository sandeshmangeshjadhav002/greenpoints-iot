# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-please-use-a-strong-32-char-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173

# ── IoT Device ───────────────────────────────────────────────────────────────
DEFAULT_BIN_HEIGHT_CM=50
FULL_THRESHOLD_PERCENT=90
NEAR_FULL_THRESHOLD_PERCENT=75
OFFLINE_TIMEOUT_SECONDS=300

# ── EcoPoints ────────────────────────────────────────────────────────────────
POINTS_PER_KG_GENERAL=2
POINTS_PER_KG_RECYCLABLE=5
POINTS_PER_KG_ORGANIC=3
POINTS_PER_KG_EWASTE=10
POINTS_BASE_DISPOSAL=1

# ── AI (optional) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-3.5-turbo-0125
